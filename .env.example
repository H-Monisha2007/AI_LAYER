# Environment Configuration for DeepForensics

APP_NAME="DeepForensics"
APP_ENV="development"
DEBUG=True
API_PREFIX="/api"
PORT=8000
HOST="0.0.0.0"

# Security
SECRET_KEY="deepforensics_secret_key_super_secure_change_in_production"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./deepforensics.db"
# PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/deepforensics"

# Media Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=100
ALLOWED_IMAGE_EXTENSIONS="jpg,jpeg,png,webp,bmp"
ALLOWED_VIDEO_EXTENSIONS="mp4,avi,mov,mkv,webm"

# ML Hardware Acceleration
FORCE_CPU=False
BATCH_SIZE=8
NUM_WORKERS=2
MODEL_WEIGHTS_DIR="./model_weights"

# MLflow Tracking
MLFLOW_TRACKING_URI="./mlruns"
